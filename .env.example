# Copy to .env and adjust. .env is gitignored.

# ---- Chat model provider: "ollama" (local) or "anthropic" (cloud) ----
LLM_PROVIDER=ollama
# Model for the selected provider.
#   ollama    -> e.g. llama3.1, qwen2.5, mistral   (must be `ollama pull`ed)
#   anthropic -> e.g. claude-opus-4-8, claude-sonnet-4-6, claude-haiku-4-5
LLM_MODEL=llama3.1

# ---- Embedding provider (used for BOTH ingest and query — keep it consistent) ----
EMBED_PROVIDER=ollama
EMBED_MODEL=nomic-embed-text

# ---- Ollama endpoint ----
# Native Ollama on host:   http://localhost:11434
# Docker compose service:  http://ollama:11434   (set automatically by compose)
OLLAMA_BASE_URL=http://localhost:11434

# ---- Anthropic (only needed when LLM_PROVIDER=anthropic) ----
ANTHROPIC_API_KEY=

# ---- Retrieval / chunking ----
RETRIEVAL_K=4
CHUNK_SIZE=800
CHUNK_OVERLAP=100
